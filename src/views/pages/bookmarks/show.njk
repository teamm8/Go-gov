{% extends "layouts/base.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}

{% block beforeContent %}
  {{ govukBreadcrumbs({
    items: [
      {
        text: "Home",
        href: "/"
      },
      {
        text: "All go links",
        href: "/bookmarks"
      },
      {
        text: bookmark.keyword
      }
    ]
  }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">
        Go Link: {{ bookmark.keyword }}
      </h1>

      <div class="govuk-button-group">
        <a href="/go/{{ bookmark.keyword | urlencode }}" class="govuk-button" data-module="govuk-button">
          Try this go link
        </a>

        {% if isAuthenticated %}
          <a href="/bookmarks/{{ bookmark.id }}/edit" class="govuk-button govuk-button--secondary" data-module="govuk-button">
            Edit
          </a>
        {% endif %}

        {% if user and user.role == 'admin' %}
          <form action="/bookmarks/{{ bookmark.id }}/delete" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this go link?');">
            <button type="submit" class="govuk-button govuk-button--warning" data-module="govuk-button">
              Delete
            </button>
          </form>
        {% endif %}
      </div>

      <h2 class="govuk-heading-m">Details</h2>

      {{ govukSummaryList({
        rows: [
          {
            key: {
              text: "Keyword"
            },
            value: {
              text: bookmark.keyword
            }
          },
          {
            key: {
              text: "URL"
            },
            value: {
              html: '<a href="' + bookmark.url + '" class="govuk-link" target="_blank" rel="noopener noreferrer">' + bookmark.url + '</a>'
            }
          },
          {
            key: {
              text: "Description"
            },
            value: {
              text: bookmark.description if bookmark.description else "No description"
            }
          },
          {
            key: {
              text: "Search template"
            },
            value: {
              html: '<code>' + bookmark.search_template + '</code>' if bookmark.search_template else "Not configured"
            }
          },
          {
            key: {
              text: "Usage count"
            },
            value: {
              text: bookmark.usage_count + " " + ("use" if bookmark.usage_count == 1 else "uses")
            }
          },
          {
            key: {
              text: "Created"
            },
            value: {
              text: bookmark.created_at | date("DD/MM/YYYY HH:mm") if bookmark.created_at else "Unknown"
            }
          },
          {
            key: {
              text: "Last updated"
            },
            value: {
              text: bookmark.updated_at | date("DD/MM/YYYY HH:mm") if bookmark.updated_at else "Unknown"
            }
          }
        ]
      }) }}

      <h2 class="govuk-heading-m govuk-!-margin-top-6">Usage examples</h2>

      <table class="govuk-table">
        <thead class="govuk-table__head">
          <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">Type</th>
            <th scope="col" class="govuk-table__header">Result</th>
          </tr>
        </thead>
        <tbody class="govuk-table__body">
          <tr class="govuk-table__row">
            <td class="govuk-table__cell">
              <code>go {{ bookmark.keyword }}</code>
            </td>
            <td class="govuk-table__cell">
              {{ bookmark.url }}
            </td>
          </tr>
          <tr class="govuk-table__row">
            <td class="govuk-table__cell">
              <code>go {{ bookmark.keyword }}/path</code>
            </td>
            <td class="govuk-table__cell">
              {{ bookmark.url }}{{ "/" if not bookmark.url.endsWith("/") else "" }}path
            </td>
          </tr>
          {% if bookmark.search_template %}
            <tr class="govuk-table__row">
              <td class="govuk-table__cell">
                <code>go {{ bookmark.keyword }}?query</code>
              </td>
              <td class="govuk-table__cell">
                {{ bookmark.search_template | replace("{query}", "query") }}
              </td>
            </tr>
          {% endif %}
        </tbody>
      </table>

      <p class="govuk-body">
        <a href="/bookmarks/{{ bookmark.id }}/history" class="govuk-link">View edit history</a>
      </p>
    </div>
  </div>
{% endblock %}
