{% extends "layouts/base.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h1 class="govuk-heading-xl govuk-!-text-align-centre">
        Go-gov
      </h1>

      <p class="govuk-body-l govuk-!-text-align-centre">
        Quick links for UK government departments
      </p>

      {# Google-style search box #}
      <div class="go-search-container" style="max-width: 600px; margin: 2rem auto;">
        <form action="/go" method="POST">
          <div class="govuk-form-group">
            <label class="govuk-label govuk-visually-hidden" for="keyword">
              Enter go link keyword
            </label>
            <input
              class="govuk-input govuk-input--width-30"
              id="keyword"
              name="keyword"
              type="text"
              placeholder="Type a keyword (e.g., 'google' or 'github/myrepo')"
              autocomplete="off"
              autofocus
              style="width: 100%; font-size: 1.2rem; padding: 0.75rem;">
          </div>

          <div class="govuk-button-group govuk-!-text-align-centre" style="justify-content: center;">
            {{ govukButton({
              text: "Go",
              type: "submit"
            }) }}

            {% if isAuthenticated %}
              <a href="/bookmarks/new" class="govuk-button govuk-button--secondary" style="text-decoration: none;">
                Create new go link
              </a>
            {% endif %}
          </div>
        </form>

        <p class="govuk-body-s govuk-!-text-align-centre" style="color: #505a5f;">
          <strong>Tips:</strong> Use <code>keyword?query</code> to search within a site, or <code>keyword/path</code> to append a path
        </p>
      </div>
    </div>
  </div>

  <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible">

  {# Statistics - 3 columns #}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-one-third">
      <h2 class="govuk-heading-m">
        <span class="govuk-caption-m">Most used</span>
        Top go links
      </h2>

      {% if topBookmarks.length > 0 %}
        <ul class="govuk-list">
          {% for bookmark in topBookmarks %}
            <li>
              <a href="/go/{{ bookmark.keyword | urlencode }}" class="govuk-link">
                <strong>{{ bookmark.keyword }}</strong>
              </a>
              <span class="govuk-body-s" style="color: #505a5f;">
                ({{ bookmark.usage_count }} {{ "use" if bookmark.usage_count == 1 else "uses" }})
              </span>
              {% if bookmark.description %}
                <br>
                <span class="govuk-body-s">{{ bookmark.description }}</span>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p class="govuk-body-s">No go links yet. Be the first to create one!</p>
      {% endif %}
    </div>

    <div class="govuk-grid-column-one-third">
      <h2 class="govuk-heading-m">
        <span class="govuk-caption-m">Recently added</span>
        New go links
      </h2>

      {% if recentBookmarks.length > 0 %}
        <ul class="govuk-list">
          {% for bookmark in recentBookmarks %}
            <li>
              <a href="/go/{{ bookmark.keyword | urlencode }}" class="govuk-link">
                <strong>{{ bookmark.keyword }}</strong>
              </a>
              {% if bookmark.description %}
                <br>
                <span class="govuk-body-s">{{ bookmark.description }}</span>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p class="govuk-body-s">No go links yet.</p>
      {% endif %}
    </div>

    <div class="govuk-grid-column-one-third">
      <h2 class="govuk-heading-m">
        <span class="govuk-caption-m">Missing links</span>
        Popular searches
      </h2>

      {% if topFailedSearches.length > 0 %}
        <ul class="govuk-list">
          {% for search in topFailedSearches %}
            <li>
              <span class="govuk-body">
                <strong>{{ search.keyword }}</strong>
              </span>
              <span class="govuk-body-s" style="color: #505a5f;">
                ({{ search.search_count }} {{ "search" if search.search_count == 1 else "searches" }})
              </span>
              {% if isAuthenticated %}
                <br>
                <a href="/bookmarks/new?keyword={{ search.keyword | urlencode }}" class="govuk-link govuk-link--no-visited-state govuk-body-s">
                  Create this link
                </a>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p class="govuk-body-s">No failed searches yet.</p>
      {% endif %}
    </div>
  </div>

  <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible">

  {# Quick stats #}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full govuk-!-text-align-centre">
      <p class="govuk-body-s" style="color: #505a5f;">
        <strong>{{ stats.totalBookmarks }}</strong> go links &nbsp;|&nbsp;
        <strong>{{ stats.totalUsage }}</strong> total uses
        {% if not isAuthenticated %}
          &nbsp;|&nbsp;
          <a href="/auth/register" class="govuk-link">Sign in to create links</a>
        {% endif %}
      </p>
    </div>
  </div>
{% endblock %}
