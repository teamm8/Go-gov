# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/go_gov
DATABASE_SSL=false

# Session
SESSION_SECRET=change-this-to-a-random-secret-key-in-production
SESSION_TIMEOUT=3600000

# Authentication - Microsoft OAuth
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_CALLBACK_URL=http://localhost:3000/auth/microsoft/callback

# Security
COOKIE_SECRET=change-this-to-another-random-secret-key
